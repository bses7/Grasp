# Postgres connection string. Local: the Docker Compose instance from `pnpm db:up`. Deployed: Neon (doc 09).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grasp

# Tutor engine behind /api/tutor (doc 03, doc 07, locked position 7). "template" is the MVP: deterministic
# templates from packages/tutor, no network. "local" is V1 only, after measurement, and needs TUTOR_LOCAL_URL.
# No hosted LLM API is ever an option (no paid tools, 2026-10-05).
TUTOR_ENGINE=template

# V1 only: base URL of a locally run open-weights model (Ollama on the lab laptop). Empty in MVP.
TUTOR_LOCAL_URL=

# Leave empty for MVP. Set to a base URL to route tutor calls to a V1/Future Python service (doc 03, services/README.md).
TUTOR_SERVICE_URL=

# Where the browser loads GLBs from. `/models` serves apps/web/public/models in MVP; an object-storage CDN URL in V1 (doc 10).
NEXT_PUBLIC_ASSET_BASE_URL=/models

# When true, gesture and mouse conditions get the identical lesson, HUD, and tutor; the only difference is the input source (doc 14).
NEXT_PUBLIC_STUDY_PARITY=true

# Secret for signing the httpOnly session cookie that carries sessionId (doc 03 Authentication). Generate 32+ random bytes.
SESSION_COOKIE_SECRET=
